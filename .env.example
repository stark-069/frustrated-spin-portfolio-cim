# Copy to .env and fill in. Never commit .env.
CIM_API_KEY=            # Optiqon CIM cloud key (cim_cloud.py scripts)
CIM_BASE_URL=           # optional; defaults to DEFAULT_BASE_URL in cim_cloud.py
OPTIQON_URL=            # direct CIM endpoint (benchmark_optiqon.py, test_rebalancing_hardware.py)
DWAVE_API_TOKEN=        # D-Wave Leap token (benchmark_dwave.py, test_20k_dwave.py)
FRED_API_KEY=           # optional, macro features in data_fetcher.py
NEWS_API_KEY=           # optional, news sentiment
EXECUTION_MODE=simulator   # simulator | tabu | steepest | exact | dwave | dwave_qpu | optiqon
